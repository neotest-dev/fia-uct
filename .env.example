# ─── Firebase Client SDK (frontend) ────────────────────────────────────────────
# Copiar este archivo como .env y completar con los valores del proyecto Firebase.
# NUNCA subir .env al repositorio.
# Estas variables sí pueden exponerse al navegador mediante Vite (prefijo VITE_).

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ─── Firebase Admin SDK (solo backend / scripts privados) ────────────────────
# NUNCA usar estas variables en el frontend ni en variables VITE_*.
# Sí pueden usarse en GitHub Actions o Vercel Serverless Functions.
# Obtener desde: Firebase Console → Configuración del proyecto → Cuentas de servicio
#                → Generar nueva clave privada (descarga un archivo .json)
#
# Opción A — Ruta a un archivo JSON local (recomendada para desarrollo local):
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
#
# Opción B — JSON en una línea (útil para GitHub Actions Secrets / CI / Vercel):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}

# ─── GitHub Dispatch (solo backend / serverless) ─────────────────────────────
# Token con permisos para disparar workflows del repositorio.
# Se usa en la serverless `api/trigger-catalog-export.js`.
# En Vercel, configurar también GITHUB_REPO_OWNER y GITHUB_REPO_NAME.
# GITHUB_TOKEN=ghp_xxx
# GITHUB_REPO_OWNER=tu-usuario-o-org
# GITHUB_REPO_NAME=fia-uct

# ─── Resumen rápido de dónde va cada variable ─────────────────────────────────
# .env local:
#   - VITE_FIREBASE_*
#   - FIREBASE_SERVICE_ACCOUNT_PATH (opcional, si exportas localmente)
# GitHub Actions Secret:
#   - FIREBASE_SERVICE_ACCOUNT_JSON
# Vercel Environment Variables:
#   - VITE_FIREBASE_*
#   - FIREBASE_SERVICE_ACCOUNT_JSON
#   - GITHUB_TOKEN
#   - GITHUB_REPO_OWNER
#   - GITHUB_REPO_NAME
